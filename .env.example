# ---------------------------------------------------------------------------
# TaskTick configuration — EVERYTHING IN THIS FILE IS OPTIONAL
#
#   Docker Compose:  you do not need this file at all. `docker compose up -d`
#                    works on a fresh clone: the container generates and persists
#                    BETTER_AUTH_SECRET itself, and docker-compose.yml supplies a
#                    working default for every value below.
#
#   From source:     copy this to `.env` and uncomment what you need.
#                    BETTER_AUTH_SECRET is auto-generated outside production and
#                    REQUIRED in it.
#
# Every assignment below is deliberately commented out. An uncommented
# placeholder would be used verbatim — a documented default secret is worse than
# no value at all, because it looks configured and is not.
# ---------------------------------------------------------------------------

# --- Core ----------------------------------------------------------------

# Public origin of this instance. Used for auth callbacks, OIDC redirect URIs
# and the webcal:// subscription links shown in Settings.
#
# Leave it at the default and browse to the same address: nothing breaks. If you
# reach the instance by IP, hostname or .local name instead, auth still works —
# a private-network origin is accepted automatically. What you give up is
# correct subscription links, which would read "localhost".
# APP_URL=http://localhost:3000

# Host port to publish. The container always listens on 3000 internally.
# PORT=3000

# Signs session cookies and derives the AES key that encrypts stored CalDAV
# passwords. It must be STABLE across restarts: losing it signs everyone out and
# makes saved calendar credentials unreadable.
#
# In Docker, leave this unset — the entrypoint generates one on first boot and
# stores it in the data volume, so it survives restarts and upgrades. Set it only
# when migrating an existing deployment.
#   generate with:  openssl rand -base64 32
# BETTER_AUTH_SECRET=

# Extra origins permitted to make state-changing auth requests.
#
# Needed only for a PUBLIC hostname (a reverse-proxied deployment), because the
# browser's origin is then neither APP_URL nor a private address. LAN access is
# already covered automatically.
#   BETTER_AUTH_TRUSTED_ORIGINS=https://tasks.example.com
# Comma separated. Wildcards are supported, e.g. https://*.example.com
# BETTER_AUTH_TRUSTED_ORIGINS=

# --- Database ------------------------------------------------------------

# Default: one self-contained SQLite file inside the container's data volume.
# DATABASE_URL=file:/data/tasktick.db

# Prefer the compose overlay over setting this by hand — it keeps the password in
# one place and makes the app wait for Postgres to be healthy:
#   docker compose -f docker-compose.yml -f docker-compose.postgres.yml up -d
# DATABASE_URL=postgres://tasktick:CHANGEME@db:5432/tasktick

# --- Accounts ------------------------------------------------------------

# open   -> anyone who can reach the instance may register
# invite -> only holders of an invite link may register (default)
# closed -> registration disabled; create users from the admin panel
#
# The first account on a fresh instance always becomes the administrator,
# whatever this is set to. That is what makes a zero-config first boot work.
# REGISTRATION_MODE=invite

# --- Single sign-on (optional) -------------------------------------------

# Any standards-compliant OpenID Connect provider: Authentik, Keycloak, Pocket
# ID, Authelia, Zitadel, Okta, Entra ID, Google Workspace...
#
# Redirect URI to register with your provider:
#   ${APP_URL}/api/auth/oauth2/callback/oidc
# OIDC_ISSUER=https://auth.example.com/application/o/tasktick/
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# OIDC_PROVIDER_NAME=Single sign-on
# Restrict sign-in to these comma-separated email domains:
# OIDC_ALLOWED_DOMAINS=example.com

# --- Web Push (optional) -------------------------------------------------

# Enables real push reminders on iOS 16.4+, once the PWA has been added to the
# Home Screen (iOS grants Web Push to installed apps only). Generate a pair with:
#   npx web-push generate-vapid-keys
#
# Both keys are needed. The public key reaches the browser through
# /api/settings at request time, so no NEXT_PUBLIC_* build variable is involved
# and a container configured at runtime works.
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:admin@localhost

# --- CalDAV background sync ----------------------------------------------

# SYNC_ENABLED=true
# How often the scheduler wakes up, in seconds. Per-account intervals are set in
# the UI; this is only the resolution of the scheduler itself.
# SYNC_TICK_SECONDS=60
# SYNC_MAX_ITEMS_PER_RUN=2000
# Set true only for a self-signed certificate on a LAN you control.
# CALDAV_ALLOW_INSECURE_TLS=false

# --- Defaults for new users ----------------------------------------------

# DEFAULT_TIMEZONE=UTC
# DEFAULT_TIME_FORMAT=24h
# 0 = Sunday, 1 = Monday
# DEFAULT_WEEK_START=1

# --- Deployment ----------------------------------------------------------

# Set true when running behind a reverse proxy you control, so X-Forwarded-For
# is trusted.
# TRUST_PROXY=false

# Normally set by the container image; only change it if you know why.
# NODE_ENV=production
