# ---------------------------------------------------------------------------
# TaskTick configuration
#
# Copy to `.env` (Docker Compose reads it automatically) and fill in the values.
# Everything here is optional for local development except BETTER_AUTH_SECRET,
# which is required in production.
# ---------------------------------------------------------------------------

# --- Core ---------------------------------------------------------------

# Public origin of this instance. Used for auth callbacks, OIDC redirect URIs
# and the webcal:// subscription links shown in Settings.
APP_URL=http://localhost:3000
PORT=3000

# REQUIRED in production. Signs session cookies and derives the AES key that
# encrypts stored CalDAV passwords. Rotating it invalidates sessions and stored
# calendar credentials (you will be asked to re-enter them).
#   generate with:  openssl rand -base64 32
BETTER_AUTH_SECRET=change-me-openssl-rand-base64-32

# --- Database -----------------------------------------------------------
# Default: a single self-contained SQLite file inside the container's volume.
DATABASE_URL=file:/data/tasktick.db

# Optional: use Postgres instead. The image ships the driver; no extra build.
# DATABASE_URL=postgres://tasktick:tasktick@db:5432/tasktick

# --- Accounts -----------------------------------------------------------
# open   -> anyone who can reach the instance may register
# invite -> only holders of an invite link may register (default)
# closed -> registration disabled entirely; manage users from the CLI
#
# The very first account created on a fresh instance always becomes the
# administrator, regardless of this setting.
REGISTRATION_MODE=invite

# --- Single sign-on (optional) -----------------------------------------
# Any standards-compliant OpenID Connect provider: Authentik, Keycloak,
# Pocket ID, Authelia, Zitadel, Okta, Entra ID, Google Workspace...
# Redirect URI to register with your provider:
#   ${APP_URL}/api/auth/oauth2/callback/oidc
# OIDC_ISSUER=https://auth.example.com/application/o/tasktick/
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# OIDC_PROVIDER_NAME=Single sign-on
# OIDC_ALLOWED_DOMAINS=example.com

# --- Web Push (optional) ------------------------------------------------
# Enables real push reminders on iOS 16.4+ once the PWA is added to the Home
# Screen. Generate a key pair with:  npx web-push generate-vapid-keys
# Both are needed: the private key signs the push, and the public key is handed to
# the browser through /api/settings so it can create a subscription.
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@localhost

# --- CalDAV background sync --------------------------------------------
SYNC_ENABLED=true
# How often the scheduler wakes up, in seconds. Per-account intervals are
# configured in the UI; this is the resolution of the scheduler itself.
SYNC_TICK_SECONDS=60
SYNC_MAX_ITEMS_PER_RUN=2000
# Set to true only for self-signed certificates on a trusted LAN.
CALDAV_ALLOW_INSECURE_TLS=false

# --- Defaults for new users --------------------------------------------
DEFAULT_TIMEZONE=UTC
DEFAULT_TIME_FORMAT=24h
# 0 = Sunday, 1 = Monday
DEFAULT_WEEK_START=1

# --- Deployment ---------------------------------------------------------
NODE_ENV=production
# Set to true when running behind a reverse proxy you control.
TRUST_PROXY=true
