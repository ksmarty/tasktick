node_modules/
.next/
out/
build/
dist/
coverage/

# Local runtime state
#
# Anchored on purpose. A bare `data/` matches a directory at *any* depth, and a
# real route directory named `data/` was ignored that way, so its `page.tsx` was
# never committed: it passed here and failed in CI, where the file is genuinely
# absent. Anything that names a source directory must be anchored.
/data/
*.db
*.db-journal
*.db-wal
*.db-shm
.env
.env.local
.env*.local

# Tooling
*.tsbuildinfo
next-env.d.ts
.DS_Store
npm-debug.log*
yarn-error.log*
.vercel
.idea/
.vscode/*
!.vscode/extensions.json

# The HACS archive, rebuilt by CI and attached to releases.
integrations/home-assistant/tasktick.zip

# Python bytecode, left behind by running the integration's tests locally.
__pycache__/
